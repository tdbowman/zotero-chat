# Zotero Chat settings
# ====================
# Copy this file to .env and adjust as needed:   cp .env.example .env
# Every setting is optional: the values shown here are the defaults used when a
# setting is missing. .env is listed in .gitignore, so it is never committed.

# ---------------------------------------------------------------- Zotero
# Zotero's data directory: the folder containing zotero.sqlite and storage/.
# Zotero shows it under Settings > Advanced > Files and Folders > Data Directory Location.
ZOTERO_DATA_DIR=~/Zotero

# Where library data is read from:
#   auto   = the local API when Zotero is running, otherwise a snapshot of zotero.sqlite
#   api    = local API only (fails if Zotero is closed)
#   sqlite = database snapshot only (works with Zotero closed)
ZOTERO_SOURCE=auto
# Zotero 7's local API. Enable it in Zotero: Settings > Advanced >
# "Allow other applications on this computer to communicate with Zotero".
ZOTERO_API_URL=http://localhost:23119/api

# Only for linked files stored as "attachments:..." paths (Zotero's "Linked Attachment
# Base Directory"). Read from Zotero's prefs.js automatically if not set.
# ZOTERO_BASE_DIR=/path/to/your/linked/files

# Very long PDFs (whole books, proceedings) are only read up to this many pages.
MAX_PDF_PAGES=600

# ---------------------------------------------------------------- Indexes
# Folder holding one index per Zotero library (my-library, group-<groupID>).
INDEX_ROOT=indexes
# Target chunk size in tokens. Changing it requires: build_index.py --all --rebuild
CHUNK_TOKENS=350

# ---------------------------------------------------------------- Models (Ollama)
OLLAMA_HOST=localhost
OLLAMA_PORT=11434

# The LLM that writes answers. Any Ollama chat model works; bigger models answer
# better but slower (e.g. gemma4:e4b-it-q4_K_M ~6.6 GB, llama3.2 ~2 GB).
LLM_MODEL=gemma4:e4b-it-q4_K_M
# Models with a "thinking" step (Gemma 4, Qwen 3, DeepSeek-R1) are much slower with it on.
LLM_THINKING=false
# Tokens the LLM can read at once (prompt + answer). The prompt is ~3,000-4,000 tokens.
LLM_CONTEXT_WINDOW=16384

# Embedding model, and the task labels it expects before queries / documents.
# These are EmbeddingGemma's. For nomic-embed-text use "search_query:" / "search_document:".
# The document label and model must match the ones the index was built with:
# after changing either, run: build_index.py --all --rebuild
EMBEDDING_MODEL=embeddinggemma
EMBED_QUERY_PREFIX=task: search result | query:
EMBED_DOC_PREFIX=title: none | text:

# ---------------------------------------------------------------- Retrieval
# Candidates each search (vector, keyword) returns per query variation.
CANDIDATE_TOP_K=20
# Candidates kept after fusing the searches; these go to the reranker.
TOP_K_RETRIEVAL=25
# 1 = search with the question as asked; N > 1 adds N-1 LLM-written rephrasings.
NUM_QUERY_VARIATIONS=3

# Cross-encoder reranker (Hugging Face model id; downloaded on first use, ~0.4 GB).
# Leave empty to skip reranking (faster, less precise; then RERANK_MIN_SCORE is unused).
RERANKER_MODEL=mixedbread-ai/mxbai-rerank-base-v1
# Passages given to the LLM, at most.
RERANK_TOP_N=6
# Passages scoring below this (0-1) are dropped. If none are left, the app says the
# library doesn't cover the question instead of letting the LLM guess.
RERANK_MIN_SCORE=0.1
# At most this many passages from any one item, so a long paper can't crowd out the rest.
MAX_CHUNKS_PER_ITEM=3

# Hugging Face cache location, and offline mode (set HF_HUB_OFFLINE=1 once the reranker
# has been downloaded, so the app starts without contacting huggingface.co).
# HF_HOME=~/.cache/huggingface
# HF_HUB_OFFLINE=1
